{
  "name": "unijam-music",
  "version": "0.1.0",
  "description": "A neutral real-time music room for groups split between Spotify and Apple Music.",
  "private": true,
  "license": "Apache-2.0",
  "author": "Mason Wyatt",
  "repository": {
    "type": "git",
    "url": "https://github.com/masonwyatt23/unijam.git"
  },
  "bugs": {
    "url": "https://github.com/masonwyatt23/unijam/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run typecheck && npm run test:domain && npm run build && npm run test:rendered",
    "typecheck": "tsc --noEmit --incremental false",
    "test:domain": "node --test lib/room-engine.test.ts lib/provider-state-engine.test.ts lib/live-room-events.test.ts lib/live-room-snapshot.test.ts lib/server/participant-session.test.ts lib/server/rate-limit.test.ts",
    "test:room-engine": "node --test lib/room-engine.test.ts",
    "test:provider-state-engine": "node --test lib/provider-state-engine.test.ts",
    "test:rendered": "node --import=./scripts/register-cloudflare-validation-loader.mjs --test tests/rendered-html.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/inter": "^5.2.8",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.24.0",
    "next": "16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "UniJam"
}
